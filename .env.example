# Copia este archivo a .env para desarrollo local (nunca subas .env real a git).
# En Render, estas mismas variables se configuran en el dashboard del servicio
# (Settings -> Environment), no en un archivo.

# Puerto en el que arranca el servidor (Render lo asigna solo vía PORT)
PORT=3000

# Ruta del archivo SQLite. En Render, debe apuntar al disco persistente montado
# (ver render.yaml -> disk.mountPath). En local, un archivo relativo basta.
DB_PATH=./db/relateready.sqlite

# Clave de API de Anthropic (Claude) para generar las 5 secciones de IA del
# Informe Extendido. Si se deja vacía, aiAnalysis.js entra en "modo simulado"
# y devuelve texto de marcador de posición — útil para probar el flujo sin
# gastar créditos, pero el informe real necesita esta clave configurada.
ANTHROPIC_API_KEY=

# Modelo de Claude a usar para las 5 secciones generadas por IA.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Payphone (Ecuador) — pago real, aún no conectado ---
# Ver services/payphone.js: mientras estas variables esten vacias, el flujo
# de pago queda en modo simulado (confirma la compra sin cobrar de verdad).
# Cuando Francisco tenga las credenciales de comercio Payphone, se completan
# aqui y se activa la integracion real siguiendo las instrucciones del
# README (seccion "Activar Payphone").
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=

# Usuario/clave del panel admin y del panel-control (/admin, /panel-control).
# Cambiar antes de desplegar.
ADMIN_USER=francisco
ADMIN_PASSWORD=cambia-esta-clave

# Clave secreta para firmar la cookie de sesión del panel (express-session).
# Cambiar antes de desplegar a un valor largo y aleatorio — si se deja vacía
# o con el valor por defecto, cualquiera que lo conozca podría falsificar
# una cookie de sesión. Generar una, por ejemplo, con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Calendario de Microsoft 365 (pestaña Calendario de /panel-control) ---
# NOTA: esta integración no usa ninguna variable de entorno — es un "public
# client" de Azure AD (MSAL con PKCE, login por popup) que vive enteramente
# en el navegador (views/panel.html), reutilizando el registro de Azure
# "Adamantine Panel Interno" ya creado para el panel de SQ Assessment
# (Client ID hardcodeado en panel.html, no es secreto: es el identificador
# público de la app, visible de todos modos en cualquier navegador).
# Lo único pendiente en Azure Portal: agregar esta URL a la lista de
# "Redirect URIs" (plataforma SPA) de ese mismo registro:
#   https://relateready-iprd.onrender.com/panel-control
# (y, si se prueba en local: http://localhost:3000/panel-control)
