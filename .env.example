# Copia este archivo a .env para desarrollo local (nunca subas .env real a git).
# En Render, estas mismas variables se configuran en el dashboard del servicio
# (Settings -> Environment), no en un archivo.

# Puerto en el que arranca el servidor (Render lo asigna solo vía PORT)
PORT=3000

# Ruta del archivo SQLite. En Render, debe apuntar al disco persistente montado
# (ver render.yaml -> disk.mountPath). En local, un archivo relativo basta.
DB_PATH=./db/relateready.sqlite

# Clave de API de Anthropic (Claude) para generar las 5 secciones de IA del
# Informe Extendido. Si se deja vacía, aiAnalysis.js entra en "modo simulado"
# y devuelve texto de marcador de posición — útil para probar el flujo sin
# gastar créditos, pero el informe real necesita esta clave configurada.
ANTHROPIC_API_KEY=

# Modelo de Claude a usar para las 5 secciones generadas por IA.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Payphone (Ecuador) — pago real, aún no conectado ---
# Ver services/payphone.js: mientras estas variables esten vacias, el flujo
# de pago queda en modo simulado (confirma la compra sin cobrar de verdad).
# Cuando Francisco tenga las credenciales de comercio Payphone, se completan
# aqui y se activa la integracion real siguiendo las instrucciones del
# README (seccion "Activar Payphone").
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=

# Usuario/clave del panel admin simple (/admin). Cambiar antes de desplegar.
ADMIN_USER=francisco
ADMIN_PASSWORD=cambia-esta-clave
